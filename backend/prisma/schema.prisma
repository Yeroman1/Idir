generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── ENUMS ───────────────────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum MembershipRole {
  CREATOR
  OFFICER
  CHAIRPERSON
  TREASURER
  SECRETARY
  COMMITTEE
  AUDITOR
  MEMBER
}

enum MembershipStatus {
  INVITED
  ACTIVE
  DECLINED
  REMOVED
  PENDING
  SUSPENDED
  DEACTIVATED
}

enum IdirStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
  SUSPENDED
  CLOSED
}

enum ContributionFrequency {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum Frequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  ANNUALLY
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  TELEBIRR
  CBE_BIRR
  OTHER
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  REVERSED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum ExpenseCategory {
  EQUIPMENT
  VENUE
  EVENT_TENT
  UTILITIES
  EMERGENCY
  FUNERAL_SUPPLIES
  ADMINISTRATIVE
  OTHER
}

enum AssistanceType {
  FUNERAL
  ILLNESS
  ACCIDENT
  PROPERTY_LOSS
  OTHER
}

enum CaseStatus {
  OPEN
  IN_REVIEW
  APPROVED
  REJECTED
  CLOSED
}

enum IkubStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum IkubParticipantStatus {
  ACTIVE
  DROPPED
  COMPLETED
}

enum RoundStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum PayoutStatus {
  PENDING
  CONFIRMED
  REVERSED
}

enum MeetingStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
  LATE
}

enum Priority {
  NORMAL
  URGENT
}

enum NotificationType {
  ANNOUNCEMENT
  PAYMENT_DUE
  PAYMENT_CONFIRMED
  ASSISTANCE_UPDATE
  IKUB_DRAW
  MEETING_REMINDER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  REVOKED
}

// ─── USER & AUTHENTICATION ───────────────────────────────────────────────────

model User {
  id                String       @id @default(uuid())
  fullName          String
  firstName         String?
  middleName        String?
  lastName          String?
  phoneNumber       String       @unique
  email             String?      @unique
  passwordHash      String
  address           String?
  dateOfBirth       DateTime?
  preferredLanguage String       @default("am") // 'am', 'en', 'om'
  status            UserStatus   @default(ACTIVE)
  isPlatformAdmin   Boolean      @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  refreshTokens          RefreshToken[]
  memberships            Membership[]
  recordedContributions  Contribution[]         @relation("RecordedContributions")
  confirmedContributions Contribution[]         @relation("ConfirmedContributions")
  reversedContributions  Contribution[]         @relation("ReversedContributions")
  recordedExpenses       Expense[]              @relation("RecordedExpenses")
  approvedExpenses       Expense[]              @relation("ApprovedExpenses")
  submittedRequests      AssistanceRequest[]    @relation("SubmittedRequests")
  reviewedRequests       AssistanceRequest[]    @relation("ReviewedRequests")
  recordedDisbursements  AssistanceDisbursement[] @relation("RecordedDisbursements")
  recordedIkubContribs   IkubContribution[]     @relation("RecordedIkubContributions")
  approvedIkubPayouts    IkubPayout[]           @relation("ApprovedIkubPayouts")
  recordedIkubPayouts    IkubPayout[]           @relation("RecordedIkubPayouts")
  createdMeetings        Meeting[]              @relation("CreatedMeetings")
  announcements          Announcement[]         @relation("CreatedAnnouncements")
  notifications          Notification[]
  auditLogs              AuditLog[]
  createdIdirs           Idir[]                 @relation("CreatedIdirs")
  createdInvitations     Invitation[]           @relation("CreatedInvitations")
  revokedInvitations     Invitation[]           @relation("RevokedInvitations")
  createdElections       Election[]             @relation("CreatedElections")

  @@index([phoneNumber])
  @@index([email])
}

model RefreshToken {
  id         String   @id @default(uuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  family     String   // Identifies the refresh token family for rotation detection
  deviceInfo String?
  ipAddress  String?
  isRevoked  Boolean  @default(false)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([family])
  @@index([tokenHash])
}

// ─── IDIR & MEMBERSHIP ───────────────────────────────────────────────────────

model Idir {
  id                     String                 @id @default(uuid())
  name                   String
  description            String?
  community              String?
  purpose                String?
  rules                  String?                @db.Text
  location               String?
  region                 String?
  zone                   String?
  woreda                 String?
  kebele                 String?
  address                String?
  contactPhone           String?
  contactEmail           String?
  currency               String                 @default("ETB")
  contributionAmount     Decimal?               @db.Decimal(14, 2)
  contributionFrequency  ContributionFrequency?
  status                 IdirStatus             @default(ACTIVE)
  createdById            String?
  createdBy              User?                  @relation("CreatedIdirs", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  settings               IdirSettings?
  memberships            Membership[]
  contributionTypes      ContributionType[]
  contributions          Contribution[]
  expenses               Expense[]
  assistanceCases        AssistanceCase[]
  assistanceDisbursements AssistanceDisbursement[]
  ikubGroups             IkubGroup[]
  meetings               Meeting[]
  announcements          Announcement[]
  auditLogs              AuditLog[]
  invitations            Invitation[]
  elections              Election[]
  roleTerms              RoleTerm[]
  noConfidenceVotes      NoConfidenceVote[]

  @@index([name])
  @@index([region])
  @@index([status])
  @@index([createdById])
}

model IdirSettings {
  id                   String    @id @default(uuid())
  idirId               String    @unique
  idir                 Idir      @relation(fields: [idirId], references: [id], onDelete: Cascade)
  regularDuesAmount    Decimal   @default(100.00) @db.Decimal(14, 2)
  duesFrequency        Frequency @default(MONTHLY)
  latePaymentGraceDays Int       @default(15)
  meetingFrequency     Frequency @default(MONTHLY)
  allowIkub            Boolean   @default(true)
  maxAssistancePerYear Decimal?  @db.Decimal(14, 2)
  requireMultiApproval Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model Membership {
  id           String           @id @default(uuid())
  idirId       String
  idir         Idir             @relation(fields: [idirId], references: [id], onDelete: Cascade)
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  memberNumber String
  role         MembershipRole   @default(MEMBER)
  status       MembershipStatus @default(ACTIVE)
  joinedAt     DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  contributions                Contribution[]
  assistanceCases              AssistanceCase[]
  ikubParticipants             IkubParticipant[]
  meetingAttendances           MeetingAttendance[]
  electionCommitteeMemberships ElectionCommitteeMember[]
  candidateNominations         ElectionNomination[]      @relation("NominatedCandidate")
  filedNominations             ElectionNomination[]      @relation("NominatedByMember")
  voteReceipts                 VoteReceipt[]
  openBallots                  Ballot[]                  @relation("OpenBallots")
  disputesFiled                ElectionDispute[]
  roleTerms                    RoleTerm[]
  noConfidenceTargets          NoConfidenceVote[]   @relation("NoConfidenceTarget")
  noConfidenceInitiated        NoConfidenceVote[]   @relation("NoConfidenceInitiator")
  noConfidenceBallots          NoConfidenceBallot[]

  @@unique([idirId, userId])
  @@unique([idirId, memberNumber])
  @@index([idirId])
  @@index([userId])
  @@index([role])
  @@index([status])
}

// ─── CONTRIBUTIONS & EXPENSES ────────────────────────────────────────────────

model ContributionType {
  id            String         @id @default(uuid())
  idirId        String
  idir          Idir           @relation(fields: [idirId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  defaultAmount Decimal?       @db.Decimal(14, 2)
  isMandatory   Boolean        @default(true)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  contributions Contribution[]

  @@index([idirId])
}

model Contribution {
  id                 String           @id @default(uuid())
  idirId             String
  idir               Idir             @relation(fields: [idirId], references: [id], onDelete: Restrict)
  membershipId       String
  membership         Membership       @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  contributionTypeId String
  contributionType   ContributionType @relation(fields: [contributionTypeId], references: [id], onDelete: Restrict)
  amount             Decimal          @db.Decimal(14, 2)
  currency           String           @default("ETB")
  paymentDate        DateTime
  paymentMethod      PaymentMethod    @default(CASH)
  paymentReference   String?
  receiptNumber      String           @unique
  status             PaymentStatus    @default(CONFIRMED)
  recordedById       String
  recordedBy         User             @relation("RecordedContributions", fields: [recordedById], references: [id], onDelete: Restrict)
  confirmedById      String?
  confirmedBy        User?            @relation("ConfirmedContributions", fields: [confirmedById], references: [id], onDelete: SetNull)
  confirmedAt        DateTime?
  isReversed         Boolean          @default(false)
  reversalReason     String?
  reversedAt         DateTime?
  reversedById       String?
  reversedBy         User?            @relation("ReversedContributions", fields: [reversedById], references: [id], onDelete: SetNull)
  clientMutationId   String?          @unique // Offline idempotency key
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([idirId])
  @@index([membershipId])
  @@index([status])
  @@index([paymentDate])
  @@index([clientMutationId])
}

model Expense {
  id              String          @id @default(uuid())
  idirId          String
  idir            Idir            @relation(fields: [idirId], references: [id], onDelete: Restrict)
  category        ExpenseCategory @default(OTHER)
  amount          Decimal         @db.Decimal(14, 2)
  currency        String          @default("ETB")
  expenseDate     DateTime
  description     String
  receiptUrl      String?
  status          ApprovalStatus  @default(PENDING)
  recordedById    String
  recordedBy      User            @relation("RecordedExpenses", fields: [recordedById], references: [id], onDelete: Restrict)
  approvedById    String?
  approvedBy      User?           @relation("ApprovedExpenses", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([idirId])
  @@index([status])
  @@index([expenseDate])
}

// ─── ASSISTANCE (EMERGENCY & FUNERAL) ────────────────────────────────────────

model AssistanceCase {
  id               String         @id @default(uuid())
  idirId           String
  idir             Idir           @relation(fields: [idirId], references: [id], onDelete: Restrict)
  membershipId     String
  membership       Membership     @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  caseType         AssistanceType @default(FUNERAL)
  title            String
  description      String
  deceasedName     String?
  deceasedRelation String?
  openedAt         DateTime       @default(now())
  status           CaseStatus     @default(OPEN)
  isConfidential   Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  requests AssistanceRequest[]

  @@index([idirId])
  @@index([membershipId])
  @@index([status])
}

model AssistanceRequest {
  id              String         @id @default(uuid())
  caseId          String
  case            AssistanceCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  requestedAmount Decimal        @db.Decimal(14, 2)
  currency        String         @default("ETB")
  justification   String
  submittedById   String
  submittedBy     User           @relation("SubmittedRequests", fields: [submittedById], references: [id], onDelete: Restrict)
  status          ApprovalStatus @default(PENDING)
  reviewedById    String?
  reviewedBy      User?          @relation("ReviewedRequests", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  reviewNotes     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  disbursements AssistanceDisbursement[]

  @@index([caseId])
  @@index([status])
}

model AssistanceDisbursement {
  id               String            @id @default(uuid())
  requestId        String
  request          AssistanceRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  idirId           String
  idir             Idir              @relation(fields: [idirId], references: [id], onDelete: Restrict)
  amount           Decimal           @db.Decimal(14, 2)
  currency         String            @default("ETB")
  disbursedAt      DateTime          @default(now())
  recipientName    String
  recipientPhone   String?
  paymentMethod    PaymentMethod     @default(CASH)
  paymentReference String?
  receiptNumber    String            @unique
  recordedById     String
  recordedBy       User              @relation("RecordedDisbursements", fields: [recordedById], references: [id], onDelete: Restrict)
  createdAt        DateTime          @default(now())

  @@index([requestId])
  @@index([idirId])
  @@index([receiptNumber])
}

// ─── IKUB (ROTATING SAVINGS) ─────────────────────────────────────────────────

model IkubGroup {
  id                 String     @id @default(uuid())
  idirId             String
  idir               Idir       @relation(fields: [idirId], references: [id], onDelete: Restrict)
  name               String
  description        String?
  contributionAmount Decimal    @db.Decimal(14, 2)
  currency           String     @default("ETB")
  frequency          Frequency  @default(WEEKLY)
  startDate          DateTime
  endDate            DateTime?
  status             IkubStatus @default(ACTIVE)
  totalRounds        Int        @default(10)
  payoutRule         String     @default("LOTTERY") // 'LOTTERY', 'FIXED_ORDER', 'NEED_BASED'
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  participants IkubParticipant[]
  rounds       IkubRound[]

  @@index([idirId])
  @@index([status])
}

model IkubParticipant {
  id           String                @id @default(uuid())
  ikubGroupId  String
  ikubGroup    IkubGroup             @relation(fields: [ikubGroupId], references: [id], onDelete: Cascade)
  membershipId String
  membership   Membership            @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  payoutOrder  Int?
  joinedAt     DateTime              @default(now())
  status       IkubParticipantStatus @default(ACTIVE)
  hasWonPayout Boolean               @default(false)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  contributions IkubContribution[]
  payouts       IkubPayout[]

  @@unique([ikubGroupId, membershipId])
  @@index([ikubGroupId])
  @@index([membershipId])
}

model IkubRound {
  id                     String      @id @default(uuid())
  ikubGroupId            String
  ikubGroup              IkubGroup   @relation(fields: [ikubGroupId], references: [id], onDelete: Cascade)
  roundNumber            Int
  scheduledDate          DateTime
  recipientParticipantId String?
  status                 RoundStatus @default(SCHEDULED)
  completedAt            DateTime?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  contributions IkubContribution[]
  payout        IkubPayout?

  @@unique([ikubGroupId, roundNumber])
  @@index([ikubGroupId])
  @@index([status])
}

model IkubContribution {
  id               String          @id @default(uuid())
  roundId          String
  round            IkubRound       @relation(fields: [roundId], references: [id], onDelete: Cascade)
  participantId    String
  participant      IkubParticipant @relation(fields: [participantId], references: [id], onDelete: Restrict)
  amount           Decimal         @db.Decimal(14, 2)
  currency         String          @default("ETB")
  status           PaymentStatus   @default(CONFIRMED)
  paymentDate      DateTime        @default(now())
  paymentMethod    PaymentMethod   @default(CASH)
  paymentReference String?
  recordedById     String
  recordedBy       User            @relation("RecordedIkubContributions", fields: [recordedById], references: [id], onDelete: Restrict)
  clientMutationId String?         @unique
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([roundId, participantId])
  @@index([roundId])
  @@index([participantId])
  @@index([status])
}

model IkubPayout {
  id                     String          @id @default(uuid())
  roundId                String          @unique // Ensures strictly 1 payout per round
  round                  IkubRound       @relation(fields: [roundId], references: [id], onDelete: Restrict)
  recipientParticipantId String
  recipientParticipant   IkubParticipant @relation(fields: [recipientParticipantId], references: [id], onDelete: Restrict)
  amount                 Decimal         @db.Decimal(14, 2)
  currency               String          @default("ETB")
  payoutDate             DateTime        @default(now())
  status                 PayoutStatus    @default(CONFIRMED)
  paymentMethod          PaymentMethod   @default(CASH)
  paymentReference       String?
  approvedById           String
  approvedBy             User            @relation("ApprovedIkubPayouts", fields: [approvedById], references: [id], onDelete: Restrict)
  recordedById           String
  recordedBy             User            @relation("RecordedIkubPayouts", fields: [recordedById], references: [id], onDelete: Restrict)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  @@index([roundId])
  @@index([recipientParticipantId])
}

// ─── MEETINGS, ANNOUNCEMENTS & NOTIFICATIONS ─────────────────────────────────

model Meeting {
  id          String        @id @default(uuid())
  idirId      String
  idir        Idir          @relation(fields: [idirId], references: [id], onDelete: Cascade)
  title       String
  agenda      String?
  location    String?
  scheduledAt DateTime
  status      MeetingStatus @default(SCHEDULED)
  minutes     String?
  createdById String
  createdBy   User          @relation("CreatedMeetings", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  attendances MeetingAttendance[]

  @@index([idirId])
  @@index([scheduledAt])
}

model MeetingAttendance {
  id         String           @id @default(uuid())
  meetingId  String
  meeting    Meeting          @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  membershipId String
  membership Membership       @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  status     AttendanceStatus @default(PRESENT)
  remarks    String?
  recordedAt DateTime         @default(now())

  @@unique([meetingId, membershipId])
  @@index([meetingId])
  @@index([membershipId])
}

enum AnnouncementTarget {
  ALL
  COMMITTEE
  MEMBERS
}

model Announcement {
  id          String             @id @default(uuid())
  idirId      String
  idir        Idir               @relation(fields: [idirId], references: [id], onDelete: Cascade)
  title       String
  body        String
  priority    Priority           @default(NORMAL)
  target      AnnouncementTarget @default(ALL)
  isPinned    Boolean            @default(false)
  publishedAt DateTime           @default(now())
  createdById String
  createdBy   User               @relation("CreatedAnnouncements", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([idirId])
  @@index([publishedAt])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  type      NotificationType @default(ANNOUNCEMENT)
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([readAt])
}

// ─── AUDIT TRAIL ─────────────────────────────────────────────────────────────

model AuditLog {
  id           String   @id @default(uuid())
  actorId      String?
  actor        User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  idirId       String?
  idir         Idir?    @relation(fields: [idirId], references: [id], onDelete: SetNull)
  action       String   // e.g. "RECORD_CONTRIBUTION", "APPROVE_EXPENSE", "DISBURSE_ASSISTANCE", "RECORD_PAYOUT"
  entityType   String   // e.g. "Contribution", "Expense", "AssistanceDisbursement", "IkubPayout"
  entityId     String
  safeMetadata Json?    // Sanitized payload (passwords, tokens, sensitive case data stripped)
  ipAddress    String?
  userAgent    String?
  timestamp    DateTime @default(now())

  @@index([idirId])
  @@index([actorId])
  @@index([entityType, entityId])
  @@index([timestamp])
}

// ─── INVITATIONS ─────────────────────────────────────────────────────────────

model Invitation {
  id          String           @id @default(uuid())
  idirId      String
  idir        Idir             @relation(fields: [idirId], references: [id], onDelete: Cascade)
  phoneNumber String?
  email       String?
  tokenHash   String           @unique
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime
  singleUse   Boolean          @default(true)
  usedAt      DateTime?
  createdById String
  createdBy   User             @relation("CreatedInvitations", fields: [createdById], references: [id], onDelete: Cascade)
  revokedById String?
  revokedBy   User?            @relation("RevokedInvitations", fields: [revokedById], references: [id], onDelete: SetNull)
  revokedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([idirId, phoneNumber])
  @@index([idirId, email])
  @@index([tokenHash])
  @@index([idirId, status])
}

// ─── LEADER ELECTIONS ────────────────────────────────────────────────────────

enum ElectionStatus {
  DRAFT
  NOMINATING
  VOTING
  TALLYING
  DISPUTED
  COMPLETED
  CANCELLED
}

enum VotingMethod {
  SIMPLE_MAJORITY
  RUNOFF
}

enum BallotType {
  SECRET
  OPEN
}

enum NominationStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
}

enum DisputeStatus {
  PENDING
  RESOLVED
  DISMISSED
}

model Election {
  id                      String           @id @default(uuid())
  idirId                  String
  idir                    Idir             @relation(fields: [idirId], references: [id], onDelete: Cascade)
  title                   String
  description             String?
  roles                   MembershipRole[]
  startDate               DateTime
  endDate                 DateTime
  nominationStartDate     DateTime?
  nominationEndDate       DateTime?
  termLengthMonths        Int              @default(12)
  votingMethod            VotingMethod     @default(SIMPLE_MAJORITY)
  ballotType              BallotType       @default(SECRET)
  quorumPercentage        Decimal          @default(50.00) @db.Decimal(5, 2)
  minMembershipTenureDays Int              @default(0)
  requiresGoodStanding    Boolean          @default(true)
  status                  ElectionStatus   @default(DRAFT)
  disputeWindowHours      Int              @default(48)
  handoverDate            DateTime?
  createdById             String
  createdBy               User             @relation("CreatedElections", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  committeeMembers        ElectionCommitteeMember[]
  nominations             ElectionNomination[]
  voteReceipts            VoteReceipt[]
  ballots                 Ballot[]
  results                 ElectionResult[]
  disputes                ElectionDispute[]

  @@index([idirId])
  @@index([status])
  @@index([startDate, endDate])
}

model ElectionCommitteeMember {
  id           String     @id @default(uuid())
  electionId   String
  election     Election   @relation(fields: [electionId], references: [id], onDelete: Cascade)
  membershipId String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role         String     @default("COMMITTEE_MEMBER")
  assignedAt   DateTime   @default(now())

  @@unique([electionId, membershipId])
  @@index([electionId])
  @@index([membershipId])
}

model ElectionNomination {
  id                      String           @id @default(uuid())
  electionId              String
  election                Election         @relation(fields: [electionId], references: [id], onDelete: Cascade)
  role                    MembershipRole
  nomineeMembershipId     String
  nomineeMembership       Membership       @relation("NominatedCandidate", fields: [nomineeMembershipId], references: [id], onDelete: Cascade)
  nominatedByMembershipId String?
  nominatedByMembership   Membership?      @relation("NominatedByMember", fields: [nominatedByMembershipId], references: [id], onDelete: SetNull)
  statement               String?          @db.Text
  status                  NominationStatus @default(PENDING)
  acceptedAt              DateTime?
  declinedAt              DateTime?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  ballots                 Ballot[]
  resultsWon              ElectionResult[]

  @@unique([electionId, role, nomineeMembershipId])
  @@index([electionId, status])
  @@index([nomineeMembershipId])
}

model VoteReceipt {
  id               String         @id @default(uuid())
  electionId       String
  election         Election       @relation(fields: [electionId], references: [id], onDelete: Cascade)
  membershipId     String
  membership       Membership     @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role             MembershipRole
  votedAt          DateTime       @default(now())
  receiptTokenHash String?

  @@unique([electionId, role, membershipId])
  @@index([electionId])
  @@index([membershipId])
}

model Ballot {
  id                    String              @id @default(uuid())
  electionId            String
  election              Election            @relation(fields: [electionId], references: [id], onDelete: Cascade)
  role                  MembershipRole
  candidateNominationId String?
  candidateNomination   ElectionNomination? @relation(fields: [candidateNominationId], references: [id], onDelete: Cascade)
  voterMembershipId     String?
  voterMembership       Membership?         @relation("OpenBallots", fields: [voterMembershipId], references: [id], onDelete: SetNull)
  castAt                DateTime            @default(now())

  @@index([electionId])
  @@index([candidateNominationId])
}

model ElectionResult {
  id                  String              @id @default(uuid())
  electionId          String
  election            Election            @relation(fields: [electionId], references: [id], onDelete: Cascade)
  role                MembershipRole
  winnerNominationId  String?
  winnerNomination    ElectionNomination? @relation(fields: [winnerNominationId], references: [id], onDelete: SetNull)
  totalVotesCast      Int                 @default(0)
  votesReceived       Int                 @default(0)
  quorumReached       Boolean             @default(false)
  isFinal             Boolean             @default(false)
  disputeWindowEndsAt DateTime?
  createdAt           DateTime            @default(now())

  @@unique([electionId, role])
  @@index([electionId])
}

model ElectionDispute {
  id                  String        @id @default(uuid())
  electionId          String
  election            Election      @relation(fields: [electionId], references: [id], onDelete: Cascade)
  filedByMembershipId String
  filedByMembership   Membership    @relation(fields: [filedByMembershipId], references: [id], onDelete: Cascade)
  reason              String        @db.Text
  status              DisputeStatus @default(PENDING)
  resolution          String?       @db.Text
  resolvedAt          DateTime?
  resolvedById        String?
  createdAt           DateTime      @default(now())

  @@index([electionId])
  @@index([filedByMembershipId])
}

model RoleTerm {
  id           String         @id @default(uuid())
  idirId       String
  idir         Idir           @relation(fields: [idirId], references: [id], onDelete: Cascade)
  membershipId String
  membership   Membership     @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role         MembershipRole
  startDate    DateTime
  endDate      DateTime
  electionId   String?
  status       String         @default("ACTIVE")
  createdAt    DateTime       @default(now())

  @@index([idirId])
  @@index([membershipId])
}

// ─── NO-CONFIDENCE VOTES & LEADERSHIP EVENTS (Task 5) ────────────────────────

enum NoConfidenceStatus {
  ACTIVE
  PASSED
  FAILED
  FAILED_NO_QUORUM
  CANCELLED
}

enum NoConfidenceChoice {
  SUPPORT
  OPPOSE
}

model NoConfidenceVote {
  id                      String              @id @default(uuid())
  idirId                  String
  idir                    Idir                @relation(fields: [idirId], references: [id], onDelete: Cascade)
  targetMembershipId      String
  targetMembership        Membership          @relation("NoConfidenceTarget", fields: [targetMembershipId], references: [id], onDelete: Cascade)
  targetRole              MembershipRole
  initiatedByMembershipId String
  initiatedByMembership   Membership          @relation("NoConfidenceInitiator", fields: [initiatedByMembershipId], references: [id], onDelete: Cascade)
  reason                  String              @db.Text
  thresholdPercentage     Decimal             @default(66.67) @db.Decimal(5, 2)
  quorumPercentage        Decimal             @default(50.00) @db.Decimal(5, 2)
  startDate               DateTime            @default(now())
  endDate                 DateTime
  status                  NoConfidenceStatus  @default(ACTIVE)
  totalEligibleMembers    Int                 @default(0)
  totalVotesCast          Int                 @default(0)
  supportVotes            Int                 @default(0)
  opposeVotes             Int                 @default(0)
  resolvedAt              DateTime?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  ballots                 NoConfidenceBallot[]

  @@index([idirId])
  @@index([targetMembershipId])
  @@index([status])
}

model NoConfidenceBallot {
  id                 String              @id @default(uuid())
  voteId             String
  vote               NoConfidenceVote    @relation(fields: [voteId], references: [id], onDelete: Cascade)
  voterMembershipId  String
  voterMembership    Membership          @relation(fields: [voterMembershipId], references: [id], onDelete: Cascade)
  choice             NoConfidenceChoice
  castAt             DateTime            @default(now())

  @@unique([voteId, voterMembershipId])
  @@index([voteId])
  @@index([voterMembershipId])
}

