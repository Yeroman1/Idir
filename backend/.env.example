# Server Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# PostgreSQL Database URLs (Supports Local Postgres or Supabase Pooler)
# Local: postgresql://USER:PASSWORD@localhost:5432/DATABASE?schema=public
# Supabase Pooler (Port 6543):
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Supabase Direct / Session (Port 5432 - for migrations):
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:5432/postgres"

# Optional Supabase API Credentials
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_ANON_KEY="[YOUR_ANON_KEY]"

# JWT Authentication Secrets
JWT_ACCESS_SECRET="super-secret-access-token-key-change-in-production-min32chars"
JWT_REFRESH_SECRET="super-secret-refresh-token-key-change-in-production-min32chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Allowed Origins (comma-separated)
CORS_ORIGIN="*"

# Logging
LOG_LEVEL=info
